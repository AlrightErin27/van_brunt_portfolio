---
import type { Audit } from "./audits";
import AuditReports from "./AuditReports/AuditReports.astro";

import "./AuditCaseStudy.css";
import { Image } from "astro:assets";

type Props = {
  audit: Audit;
};

const { audit } = Astro.props;
---

<main id="main-content" class="audit-case-study" tabindex="-1">
  <article class="audit-case-study__inner">
    <!-- Page introduction -->

    <header
      class:list={[
        "audit-case-study__header",
        { "audit-case-study__header--with-image": !!audit.heroImg },
      ]}
    >
      {/* Decorative hero image, displayed when available */}
      {
        audit.heroImg && (
          <div class="audit-case-study__hero-media" aria-hidden="true">
            <Image
              src={audit.heroImg}
              alt=""
              class="audit-case-study__hero-image"
              priority
              layout="full-width"
              sizes="(max-width: 48rem) 100vw, 65vw"
            />
          </div>
        )
      }

      <a class="audit-case-study__back-link" href="/audits"> ← All audits </a>

      <p class="audit-case-study__eyebrow">
        {audit.category}
      </p>

      <h1 class="audit-case-study__title">
        {audit.title}
      </h1>

      <p class="audit-case-study__site">
        {
          audit.siteUrl ? (
            <a href={audit.siteUrl}>{audit.siteName}</a>
          ) : (
            audit.siteName
          )
        }
      </p>
    </header>

    <!-- Why this site was selected -->
    <section
      class="audit-case-study__section"
      aria-labelledby="overview-heading"
    >
      <div class="audit-case-study__section-heading">
        <p class="audit-case-study__number" aria-hidden="true">01</p>

        <h2 id="overview-heading">About this audit</h2>
      </div>

      <div class="audit-case-study__section-content">
        <p class="audit-case-study__lead">
          {audit.introduction}
        </p>
      </div>
    </section>

    <!-- Testing scope and methods -->
    <section
      class="audit-case-study__section"
      aria-labelledby="methodology-heading"
    >
      <div class="audit-case-study__section-heading">
        <p class="audit-case-study__number" aria-hidden="true">02</p>

        <h2 id="methodology-heading">Scope &amp; methodology</h2>
      </div>

      <div class="audit-case-study__section-content">
        <p>
          {audit.scope}
        </p>

        <h3 class="audit-case-study__subheading">Testing methods</h3>

        <ul class="audit-case-study__methods">
          {audit.methodology.map((method) => <li>{method}</li>)}
        </ul>
      </div>
    </section>

    <!-- Accessible HTML version of the audit report -->

    <!-- Completed evaluation reports -->
    <section class="audit-case-study__section" aria-labelledby="report-heading">
      <div class="audit-case-study__section-heading">
        <p class="audit-case-study__number" aria-hidden="true">03</p>

        <h2 id="report-heading">Accessibility evaluation reports</h2>
      </div>

      <div class="audit-case-study__section-content">
        {
          audit.reports && audit.reports.length > 0 ? (
            <>
              <p>
                The following reports document the completed accessibility
                evaluation work. Each report is available to view in your
                browser or download as a PDF.
              </p>

              <AuditReports reports={audit.reports} />
            </>
          ) : (
            <p class="audit-case-study__placeholder">
              Evaluation reports are not available yet.
            </p>
          )
        }
      </div>
    </section>

    <!-- Recorded walkthrough -->
    <section class="audit-case-study__section" aria-labelledby="video-heading">
      <div class="audit-case-study__section-heading">
        <p class="audit-case-study__number" aria-hidden="true">04</p>

        <h2 id="video-heading">Video walkthrough</h2>
      </div>

      <div class="audit-case-study__section-content">
        <p>
          A recorded walkthrough of the testing process, findings, and decisions
          made during the audit.
        </p>

        {
          audit.videoUrl ? (
            <div class="audit-case-study__video">
              <iframe
                src={audit.videoUrl}
                title={`Video walkthrough for ${audit.title}`}
                loading="lazy"
                allowfullscreen
              />
            </div>
          ) : (
            <div class="audit-case-study__media-placeholder">
              <p>
                Video walkthrough will be added after the audit is complete.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Longer reflection lives outside the audit report -->
    <section
      class="audit-case-study__section"
      aria-labelledby="reflection-heading"
    >
      <div class="audit-case-study__section-heading">
        <p class="audit-case-study__number" aria-hidden="true">05</p>

        <h2 id="reflection-heading">Reflection</h2>
      </div>

      <div class="audit-case-study__section-content">
        <p>Behind the audit.</p>

        {
          audit.reflectionUrl ? (
            <>
              <p>
                In this personal blog post, I reflect on my accessibility
                evaluation of Scotts Valley Market, one of the projects featured
                in this portfolio. I share what surprised me about the online
                shopping experience, the accessibility barriers I uncovered, and
                what I learned when the website was unexpectedly redesigned
                mid-audit.
              </p>

              <a class="audit-case-study__button" href={audit.reflectionUrl}>
                Read my reflection on Medium
                <span aria-hidden="true">↗</span>
              </a>
            </>
          ) : (
            <p class="audit-case-study__placeholder">Reflection coming soon.</p>
          )
        }
      </div>
    </section>
  </article>
</main>
