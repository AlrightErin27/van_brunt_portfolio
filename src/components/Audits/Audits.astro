---
import "./Audits.css";

type Audit = {
    title: string;
    label: string;
    description: string;
    href: string;
};

const audits: Audit[] = [
    {
        title: "First Audit",
        label: "E-commerce Audit",
        description:
            "A small local e-commerce site. This gives you real interactive UI to test: navigation, product cards, images/alt text, filters, forms, cart controls, error handling, focus states, and possibly checkout. Ideally pick an independent local business using Shopify, Squarespace, WooCommerce, etc.—not Amazon or a giant retailer. Audit a representative flow rather than the entire site: homepage → category/product → cart → checkout up to the point of purchase.",
        href: "/audits/e-commerce",
    },
    {
        title: "Second Audit",
        label: "Public-sector",
        description:
            "A local public-sector or library site. I really like the library idea. It gives the portfolio a different purpose: access to civic/community information rather than buying something. You can examine navigation, search, events, forms, headings, links, PDFs, third-party widgets, and potentially multilingual or public-resource content. A city department, public library, parks department, or small county service site could all work well. I’d avoid an enormous federal site; something smaller lets you actually tell a coherent story.",
        href: "/audits/public-sector",
    },
    {
        title: "Third Audit",
        label: "Evb-portfolio",
        description:
            "Your own portfolio. This should probably be the deepest case study because you can go beyond identifying issues. You can show audit → remediation → retest. That demonstrates QA, frontend knowledge, documentation, and accessibility implementation all at once. This one can become the proof that you don’t just know how to find problems—you know how to fix and verify them.",
        href: "/audits/evb-portfolio",
    },
];
---

<main
    id="main-content"
    tabindex="-1"
    class="audits-page"
>
    <div class="audits-page__inner">

        <header class="audits-page__intro">

            <div>
                <p class="audits-page__eyebrow">
                    Audits
                </p>

                    <h1 class="audits-page__title">
                         <span class="visually-hidden">Accessibility audits: </span>
                              Accessibility, examined.
                    </h1>
            </div>

            <div class="audits-page__summary">

                <div
                    class="audits-page__accent-line"
                    aria-hidden="true"
                ></div>

                <p>
                    These audits evaluate digital experiences through the lens of universal design, inclusive usability, and WCAG 2.2 Level AA. Each review combines manual testing, assistive technology, and automated tools to identify barriers that can affect people with disabilities.
                </p>

                <p>
                    The goal is not just to flag issues, but to understand their impact, document them clearly, and recommend practical remediation that supports more usable, resilient experiences for everyone.
                </p>

            </div>

        </header>

        <section
            class="audits-collection"
            aria-labelledby="audit-list-title"
        >

            <div class="audits-collection__heading">
                <h2 id="audit-list-title">
                    Selected audits
                </h2>
            </div>

            <ul class="audits-grid">

                {
                    audits.map((audit, index) => {
                        const auditNumber = String(index + 1).padStart(
                            2,
                            "0"
                        );

                        const titleId = `audit-${index + 1}-title`;

                        return (
                            <li class="audit-card">

                                <article
                                    class="audit-card__article"
                                    aria-labelledby={titleId}
                                >

                                    <a
                                        class="audit-card__surface audit-card__surface--link"
                                        href={audit.href}
                                        aria-label={`View audit: ${audit.title}`}
                                    >

                                        <div
                                            class="audit-card__visual"
                                            aria-hidden="true"
                                        >
                                            <span class="audit-card__number">
                                                {auditNumber}
                                            </span>
                                        </div>

                                        <div class="audit-card__body">

                                            <p class="audit-card__label">
                                                {audit.label}
                                            </p>

                                            <h3
                                                id={titleId}
                                                class="audit-card__title"
                                            >
                                                {audit.title}
                                            </h3>

                                            <p class="audit-card__description">
                                                {audit.description}
                                            </p>

                                            <div class="audit-card__action">


                                            </div>

                                        </div>

                                    </a>

                                </article>

                            </li>
                        );
                    })
                }

            </ul>

        </section>

    </div>
</main>