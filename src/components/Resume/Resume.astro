---
import { DownloadSimpleIcon, ArrowSquareOutIcon } from "@phosphor-icons/react";
import "./Resume.css";

const resumePDF = "/resumes/ErinVanBrunt_DigitalAccessibilityResume2026.pdf";

const resumeDOCX = "/resumes/ErinVanBrunt_DigitalAccessibilityResume2026.docx";
---

<main id="main-content" class="resume-page" tabindex="-1">
  <article class="resume">
    <header class="resume__header">
      <div class="resume__identity">
        <p class="resume__eyebrow">Resume</p>

        <h1 class="resume__name">
          <span class="visually-hidden">Resume: </span>
          Erin Van Brunt
        </h1>

        <p class="resume__title">
          Digital Accessibility Specialist
          <span aria-hidden="true"> | </span>
          Accessibility QA Tester
        </p>
      </div>

      <div class="resume__header-details">
        <address class="resume-contact">
          <p class="resume-contact__location">Santa Cruz, California</p>

          <nav
            class="resume-contact__navigation"
            aria-label="Resume contact links"
          >
            <ul class="resume-contact__list">
              <li>
                <a href="mailto:ErinMontyBruce@gmail.com">
                  ErinMontyBruce@gmail.com
                </a>
              </li>

              <li>
                <a href="https://www.linkedin.com/in/erin-van-brunt/">
                  LinkedIn Profile
                </a>
              </li>

              <li>
                <a href="https://github.com/AlrightErin27"> GitHub Projects </a>
              </li>

              <li>
                <a href="https://medium.com/@erinmontybruce">
                  Medium Articles
                </a>
              </li>
            </ul>
          </nav>
        </address>

        <a
          class="resume-download"
          href={resumePDF}
          download="ErinVanBrunt_DigitalAccessibilityResume2026.pdf"
        >
          <span>Download PDF resume</span>

          <DownloadSimpleIcon
            className="resume-download__icon"
            size={20}
            weight="bold"
            aria-hidden={true}
            focusable={false}
          />
        </a>

        <a
          class="resume-download"
          href={resumePDF}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>
            View PDF resume
            <span class="visually-hidden"> (opens in a new tab) </span>
          </span>

          <ArrowSquareOutIcon
            className="resume-download__icon"
            size={20}
            weight="bold"
            aria-hidden={true}
            focusable={false}
          />
        </a>

        <a
          class="resume-download"
          href={resumeDOCX}
          download="ErinVanBrunt_DigitalAccessibilityResume2026.docx"
        >
          <span>Download DOCX resume</span>

          <DownloadSimpleIcon
            className="resume-download__icon"
            size={20}
            weight="bold"
            aria-hidden={true}
            focusable={false}
          />
        </a>
      </div>
    </header>

    <!-- PROFESSIONAL SUMMARY -->

    <section
      class="resume-section resume-section--summary"
      aria-labelledby="summary-heading"
    >
      <div class="resume-section__heading">
        <p class="resume-section__number" aria-hidden="true">01</p>

        <h2 id="summary-heading">Professional Summary</h2>
      </div>

      <div class="resume-section__content">
        <p class="resume-summary">
          Digital accessibility specialist with a background in full-stack
          software engineering and hands-on experience testing, debugging, and
          improving web applications. Trained in WCAG principles, inclusive
          design, and accessibility evaluation, with practical experience in
          automated testing and technical documentation. Combines a developer's
          perspective with a quality-focused approach to identifying
          accessibility barriers and creating more inclusive digital
          experiences.
        </p>
      </div>
    </section>

    <!-- CORE SKILLS -->

    <section class="resume-section" aria-labelledby="skills-heading">
      <div class="resume-section__heading">
        <p class="resume-section__number" aria-hidden="true">02</p>

        <h2 id="skills-heading">Core Skills</h2>
      </div>

      <div class="resume-section__content">
        <dl class="resume-skills">
          <div class="resume-skills__group">
            <dt>Accessibility &amp; Inclusive Design</dt>

            <dd>
              WCAG 2.2 Level A/AA, Universal Design principles, Universal Design
              for Learning (UDL), disability models and barriers, assistive
              technology concepts, disability etiquette, accessibility laws and
              standards (ADA, Section 508), inclusive design, semantic HTML,
              ARIA fundamentals, accessible names and landmarks, color contrast,
              zoom and reflow accessibility
            </dd>
          </div>

          <div class="resume-skills__group">
            <dt>Accessibility QA &amp; Testing</dt>

            <dd>
              Manual accessibility evaluation, keyboard navigation and focus
              testing, Safari VoiceOver screen reader testing, WCAG success
              criterion mapping, accessibility defect documentation, remediation
              recommendations, functional and regression testing, Playwright,
              axe-core, axe DevTools, WAVE, Vitest, React Testing Library,
              Chrome DevTools, cross-browser testing, CI/CD quality checks
            </dd>
          </div>

          <div class="resume-skills__group">
            <dt>Programming Languages &amp; Frameworks</dt>

            <dd>
              HTML5, CSS3, JavaScript (ES6+), TypeScript, Python, SQL, Ruby,
              Java, React, Next.js, Astro, Node.js, Express.js, Flask, Ruby on
              Rails
            </dd>
          </div>

          <div class="resume-skills__group">
            <dt>Full-Stack Development &amp; Tools</dt>

            <dd>
              RESTful APIs, PostgreSQL, MySQL, MongoDB, Redis, Docker,
              Git/GitHub, Linux CLI, AWS EC2, Postman, OAuth, JWT
              authentication, Bitbucket Pipelines, responsive web development,
              technical documentation, developer collaboration
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ACCESSIBILITY QA PROJECTS -->

    <!-- ACCESSIBILITY QA PROJECTS -->

    <section class="resume-section" aria-labelledby="projects-heading">
      <div class="resume-section__heading">
        <p class="resume-section__number" aria-hidden="true">03</p>

        <h2 id="projects-heading">Accessibility QA Projects</h2>
      </div>

      <div class="resume-section__content resume-experience">
        <!-- PERSONAL PORTFOLIO AUDIT -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>
                <a
                  href="https://van-brunt-portfolio.vercel.app/audits/evb-portfolio"
                >
                  Personal Portfolio
                </a>

                <span class="resume-entry__company">
                  <br />WCAG 2.2 Accessibility Evaluation
                </span>
              </h3>
            </div>

            <p class="resume-entry__meta">
              <time datetime="2026-10"> October 2026 </time>

              <span aria-hidden="true">–</span>

              Present
            </p>
          </header>

          <ul class="resume-entry__details">
            <li>
              Conducted a targeted accessibility audit using manual keyboard
              testing, Safari VoiceOver, semantic HTML inspection, responsive
              and contrast evaluation, and automated testing with Playwright and
              axe-core.
            </li>

            <li>
              Evaluated WCAG 2.2 Level A/AA success criteria and produced
              detailed reports documenting test methods, results, observations,
              and evaluation limitations.
            </li>
          </ul>
        </article>

        <!-- SCOTTS VALLEY MARKET AUDIT -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>
                <a
                  href="https://van-brunt-portfolio.vercel.app/audits/scotts-valley-market"
                >
                  Scotts Valley Market
                </a>

                <span class="resume-entry__company">
                  <br />Independent Accessibility Evaluation
                </span>
              </h3>
            </div>

            <p class="resume-entry__meta">
              <time datetime="2026-10"> October 2026 </time>
            </p>
          </header>

          <ul class="resume-entry__details">
            <li>
              Conducted manual keyboard accessibility evaluations of website
              navigation, interactive components, product pages, and shopping
              cart interactions against selected WCAG 2.2 Level A/AA success
              criteria.
            </li>

            <li>
              Identified and documented accessibility barriers involving
              keyboard operability, focus visibility, focus management, and
              accessible names, mapping findings to applicable WCAG success
              criteria and recommending remediation.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- PROFESSIONAL EXPERIENCE -->

    <section class="resume-section" aria-labelledby="experience-heading">
      <div class="resume-section__heading">
        <p class="resume-section__number" aria-hidden="true">04</p>

        <h2 id="experience-heading">Experience</h2>
      </div>

      <div class="resume-section__content resume-experience">
        <!-- AEYESAFE -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>
                Software Engineering Intern
                <span class="resume-entry__company">
                  <br />Aeyesafe
                </span>
              </h3>
            </div>

            <p class="resume-entry__meta">
              <time datetime="2025-06"> June 2025 </time>

              <span aria-hidden="true">–</span>

              <time datetime="2025-09"> September 2025 </time>
            </p>
          </header>

          <ul class="resume-entry__details">
            <li>
              Implemented the frontend testing foundation with Vitest and jsdom,
              creating routing and rendering tests and mocks for browser APIs
              and application providers.
            </li>

            <li>
              Integrated automated tests into Husky pre-commit hooks and
              Bitbucket Pipelines, confirming that failing tests blocked commits
              before code review and merge.
            </li>

            <li>
              Audited more than 100 files, identified and safely removed dead
              code, consolidated the application's icons into Phosphor, and
              removed redundant third-party packages.
            </li>

            <li>
              Created a global CSS system, standardized large portions of
              inconsistent legacy styling, and built API-connected dashboard
              tables with pagination.
            </li>
          </ul>
        </article>

        <!-- DIGITAL FACTORY -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>
                Software Engineering Intern

                <span class="resume-entry__company">
                  <br />Digital Factory
                </span>
              </h3>
            </div>

            <p class="resume-entry__meta">
              <time datetime="2025-01"> January 2025 </time>

              <span aria-hidden="true">–</span>

              <time datetime="2025-06"> June 2025 </time>
            </p>
          </header>

          <ul class="resume-entry__details">
            <li>
              Built the functional foundation of a new internal admin portal
              using Next.js, Appwrite, and Flask, including registration, login,
              logout, session persistence, protected routes, token handling, and
              error states.
            </li>

            <li>
              Connected the portal first to mock account data and then to the
              Zeus backend, establishing a working frontend-to-backend
              integration.
            </li>

            <li>
              Reconstructed and documented a complex local backend environment
              using Docker, Flask, PostgreSQL, MongoDB, Redis, Pipenv, and
              multiple microservices.
            </li>

            <li>
              Investigated a deeply outdated legacy website, identified major
              integration and maintenance risks, and contributed to a proposal
              recommending a full rebuild rather than continued patching.
            </li>
          </ul>
        </article>

        <!-- ANALOG DEVICES -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>
                Layout Engineer

                <span class="resume-entry__company">
                  <br />Analog Devices
                </span>
              </h3>
            </div>

            <div class="resume-entry__meta">
              <p>
                <time datetime="2011">2011</time>

                <span aria-hidden="true">–</span>

                <time datetime="2014">2014</time>
              </p>

              <p>San Jose, California</p>
            </div>
          </header>

          <ul class="resume-entry__details">
            <li>
              Created and optimized more than 50 analog and digital IC layouts
              using Cadence Virtuoso.
            </li>

            <li>
              Performed DRC and LVS verification to identify layout errors,
              support design-rule compliance, and improve overall accuracy.
            </li>
          </ul>
        </article>

        <!-- RESTAURANT MANAGEMENT -->

        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>Restaurant Manager</h3>
            </div>

            <div class="resume-entry__meta">
              <p>
                <time datetime="2014">2014</time>

                <span aria-hidden="true">–</span>

                <time datetime="2025">2025</time>
              </p>

              <p>Pacific Northwest &amp; Southwest U.S.</p>
            </div>
          </header>

          <ul class="resume-entry__details">
            <li>
              Led and trained teams of 15+ employees while managing scheduling,
              staffing, inventory, bookkeeping, and daily operations.
            </li>

            <li>
              Improved workflows and team performance, contributing to a 20%
              increase in sales while maintaining health and safety compliance.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- EDUCATION & CERTIFICATIONS -->

    <section class="resume-section" aria-labelledby="education-heading">
      <div class="resume-section__heading">
        <p class="resume-section__number" aria-hidden="true">05</p>

        <h2 id="education-heading">Education &amp; Certifications</h2>
      </div>

      <div class="resume-section__content">
        <ul class="resume-education">
          <!-- UNIVERSITY OF WASHINGTON -->

          <li>
            <div>
              <h3>University of Washington</h3>
              <p>Web &amp; Digital Accessibility</p>
            </div>

            <p class="resume-education__date">
              Completed
              <time datetime="2026-07"> July 2026 </time>
            </p>
          </li>

          <!-- DEQUE WAS -->

          <li>
            <div>
              <h3>Deque University</h3>

              <p>
                Web Accessibility Specialist (WAS) Preparation, Certificate of
                Completion
              </p>
            </div>

            <p class="resume-education__date">
              <time datetime="2026">2026</time>
            </p>
          </li>

          <!-- DEQUE CPACC -->

          <li>
            <div>
              <h3>Deque University</h3>

              <p>CPACC Preparation, in progress</p>
            </div>

            <p class="resume-education__date">
              Exam scheduled
              <time datetime="2026-11"> November 2026 </time>
            </p>
          </li>

          <!-- WESTERN GOVERNORS UNIVERSITY -->

          <li>
            <div>
              <h3>Western Governors University</h3>
              <p>Python Course</p>
            </div>

            <p class="resume-education__date">
              <time datetime="2025">2025</time>
            </p>
          </li>

          <!-- ARIZONA STATE UNIVERSITY -->

          <li>
            <div>
              <h3>Arizona State University</h3>

              <p>Principles of Programming with Java</p>
            </div>

            <p class="resume-education__date">
              <time datetime="2023">2023</time>
            </p>
          </li>

          <!-- FLATIRON SCHOOL -->

          <li>
            <div>
              <h3>Flatiron School</h3>

              <p>Full-Stack Software Engineering Certificate</p>
            </div>

            <p class="resume-education__date">
              <time datetime="2022">2022</time>
            </p>
          </li>

          <!-- GENERAL ASSEMBLY -->

          <li>
            <div>
              <h3>General Assembly</h3>

              <p>Software Engineering Immersive Certificate</p>
            </div>

            <p class="resume-education__date">
              <time datetime="2021">2021</time>
            </p>
          </li>

          <!-- SILICON DESIGN INSTITUTE -->

          <li>
            <div>
              <h3>Silicon Design Institute</h3>

              <p>Mask Design / Layout Engineering</p>
            </div>

            <p class="resume-education__date">
              <time datetime="2011">2011</time>

              <span aria-hidden="true">–</span>

              <time datetime="2013">2013</time>
            </p>
          </li>
        </ul>
      </div>
    </section>
  </article>
</main>
